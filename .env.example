# Local development only. Set an individual local password before starting.
POSTGRES_USER=cpq
POSTGRES_PASSWORD=
POSTGRES_DB=cpq_development
TEST_DATABASE_NAME=cpq_test
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Explicit invitations require a real SMTP service. Never commit real credentials.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_FROM=
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
# Browser origin used in email links, e.g. http://localhost:4200 for this local setup.
APP_PUBLIC_URL=
SMTP_AUTHENTICATION=plain
